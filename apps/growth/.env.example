# Where every lead form on the site delivers.
#
# A catch hook from n8n, Make or Zapier. All three forms post here; the payload
# carries a `kind` field so you can route them:
#   kind: "free-audit"           — full audit request (8 fields)
#   kind: "contact"              — general enquiry
#   kind: "ai-visibility-check"  — homepage mini-tool (business, city, email)
#
# If this is unset the forms refuse to submit and tell the visitor to email
# Hello@nebriix.com instead, rather than silently dropping the lead.
CONTACT_WEBHOOK_URL=

# Optional. Google Analytics 4 measurement ID (G-XXXXXXXXXX). When set, GA4
# loads alongside Vercel Analytics. Leave empty to run Vercel Analytics only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. PostHog project API key (phc_...), from Project Settings.
#
# When set, PostHog loads in cookieless mode and records how visitors move
# through the site. IMPORTANT: cookieless mode must also be enabled in the
# PostHog project settings, or every event is discarded on ingest.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional. Only change these if the project is in the US cloud rather than EU.
#   EU: https://eu.posthog.com  /  https://eu.i.posthog.com   (default)
#   US: https://us.posthog.com  /  https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_INGEST=
