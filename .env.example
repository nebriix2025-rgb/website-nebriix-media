# Where contact-form submissions are delivered.
#
# A catch hook from n8n, Make or Zapier — all of which Nebriix already runs.
# Receives JSON: { name, email, subject, message, submittedAt, source }
#
# If this is unset the form refuses to submit and tells the visitor to email
# Hello@nebriix.com instead, rather than silently dropping the lead.
CONTACT_WEBHOOK_URL=
